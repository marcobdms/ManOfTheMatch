# apps/ingest — copy to .env (Coolify: set as environment variables)

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# football-data.org free token: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# API-Football free key (100 req/day): https://dashboard.api-football.com/register
API_FOOTBALL_KEY=

# TheSportsDB — live-score fallback + id cross-ref. Shared free test key is "123";
# a personal key needs Premium ($9/mo). Defaults to "123" if unset.
THESPORTSDB_KEY=123

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:hola@manofthematch.app
