{
  "name": "manofthematch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n front,back -c blue,red \"npm:dev:front\" \"npm:dev:back\"",
    "dev:front": "npm run dev -w @motm/web",
    "dev:back": "npm run dev -w @motm/ingest",
    "build": "npm run build -w @motm/web",
    "ingest": "npm run start -w @motm/ingest",
    "typecheck": "npm run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
